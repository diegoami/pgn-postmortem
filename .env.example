# Copy this file to .env and fill in your own values.
# .env is gitignored - your player name and data location never get committed.

# Whose blunders to report, matched case-insensitively against the PGN's
# White/Black headers, or '*' to report blunders by both sides (the default
# here, since neither side in the bundled examples/ games is "you"). Required
# (either here or via --player).
CHESS_PLAYER=*

# Directory holding daily_games/ (analyzed_games/ and docs/ will be written
# here too). Can be this repo itself, or a separate repo/directory kept
# apart from the scripts. Defaults here to examples/, this repo's own bundled
# master games, so the scripts work out of the box before you point it at
# your own games. Leave unset instead to default to this repo's own checkout
# (i.e. daily_games/ directly under the repo root).
CHESS_DATA_DIR=examples

# Optional tuning for scripts/analyze_games.py, all overridable per-run with
# the matching --flag (a flag always wins over these). Uncomment to change
# from the defaults shown.

# Seconds of Stockfish search per position (or set ANALYSIS_DEPTH instead for
# a fixed depth, which then takes priority over this).
# ANALYSIS_TIME=0.3
# ANALYSIS_DEPTH=

# Win% points lost (see win_percent() in analyze_games.py) to flag a move as
# $6 Inaccuracy / $2 Mistake / $4 Blunder. Defaults are lichess's own cutoffs
# (https://lichess.org/page/accuracy); lower them to flag more moves.
# ANALYSIS_INACCURACY_PCT=10
# ANALYSIS_MISTAKE_PCT=20
# ANALYSIS_BLUNDER_PCT=30
